from typing import TypedDict

__version__: str

class _BuildInfo(TypedDict):
    version: str
    commit: str | None
    dirty: bool | None

def build_info() -> _BuildInfo: ...

class OperationConflictError(RuntimeError): ...
class OperationIncompleteError(RuntimeError): ...
class OperationResultUnavailableError(RuntimeError): ...
class OperationStaleError(RuntimeError): ...
class NeedsNewReviewError(RuntimeError): ...

